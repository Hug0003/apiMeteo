# Généré au démarrage du conteneur dans /tmp/default.conf : ${OWM_API_KEY} et
# ${OPENCAGE_API_KEY} sont remplacés par les variables d'environnement (fichier
# env/sunorcloud.env sur le serveur). Les clés ne sont jamais envoyées au navigateur.
server_tokens off;

# Vraie IP du visiteur (transmise par l'Apache de 192.168.11.131), pour la limitation de débit.
set_real_ip_from 192.168.11.131;
set_real_ip_from 172.16.0.0/12;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Protège les quotas des API : 30 requêtes par minute et par visiteur.
limit_req_zone $binary_remote_addr zone=meteo_api:10m rate=30r/m;
limit_req_status 429;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    include /etc/nginx/security-headers.conf;

    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    # DNS interne de Docker, nécessaire pour proxy_pass avec des variables.
    resolver 127.0.0.11 valid=300s ipv6=off;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    # Par défaut Nginx ne vérifie qu'un niveau de la chaîne de certificats (trop peu pour OpenCage).
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    location = /api/geocode {
        limit_req zone=meteo_api burst=10 nodelay;
        if ($arg_q = "") {
            return 400;
        }
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Host api.opencagedata.com;
        proxy_pass https://api.opencagedata.com/geocode/v1/json?q=$arg_q&limit=1&no_annotations=1&key=${OPENCAGE_API_KEY};
    }

    location = /api/weather {
        limit_req zone=meteo_api burst=10 nodelay;
        if ($arg_lat !~ "^-?[0-9]{1,3}(\.[0-9]{1,10})?$") {
            return 400;
        }
        if ($arg_lon !~ "^-?[0-9]{1,3}(\.[0-9]{1,10})?$") {
            return 400;
        }
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Host api.openweathermap.org;
        proxy_pass https://api.openweathermap.org/data/2.5/weather?lat=$arg_lat&lon=$arg_lon&appid=${OWM_API_KEY};
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        return 404;
    }
    location ~* \.(py|md|scss|sass|map|tar\.gz|zip|sh|lock|template)$ {
        return 404;
    }

    location ~* \.(css|js|webp|png|jpe?g|gif|svg|ico|woff2?|ttf)$ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }
}
